<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TA_CALIFICACIONES_.Views.LoginPage"
             Title="Login">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#EAF9FF" Offset="0" />
            <GradientStop Color="#F5F7FB" Offset="1" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid Padding="24" VerticalOptions="Center">
        <Border WidthRequest="420"
                HorizontalOptions="Center"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="30"
                StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow Brush="#7AA8C5" Offset="0,12" Radius="24" Opacity="0.18" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">
                <Label Text="🎓"
                       FontSize="52"
                       HorizontalOptions="Center" />

                <Label Text="Sistema de calificaciones"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#133C5B"
                       HorizontalOptions="Center" />

                <Label Text="Iniciar sesión"
                       FontSize="18"
                       TextColor="#385D7A"
                       HorizontalOptions="Center" />

                <VerticalStackLayout Spacing="8">
                    <Label Text="Usuario" FontSize="15" TextColor="#2E3D4F" FontAttributes="Bold" />
                    <Border BackgroundColor="#F5F9FC"
                            Padding="10,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Entry x:Name="UserEntry"
                               Placeholder="Ej. Carlos"
                               TextColor="#12314A"
                               PlaceholderColor="#8AA3B3"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Contraseña" FontSize="15" TextColor="#2E3D4F" FontAttributes="Bold" />
                    <Border BackgroundColor="#F5F9FC"
                            Padding="10,0"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Ingrese su contraseña"
                               IsPassword="True"
                               TextColor="#12314A"
                               PlaceholderColor="#8AA3B3"
                               BackgroundColor="Transparent" />
                    </Border>
                </VerticalStackLayout>

                <Button x:Name="LoginButton"
                        Text="Entrar"
                        FontAttributes="Bold"
                        FontSize="16"
                        BackgroundColor="#0B8BD6"
                        TextColor="White"
                        CornerRadius="18"
                        HeightRequest="52"
                        Clicked="OnLoginClicked" />

                <Label Text="Usuarios válidos: Carlos, Ana, Jose"
                       FontSize="13"
                       TextColor="#5A6E7C"
                       HorizontalOptions="Center"
                       Margin="0,6,0,0" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
