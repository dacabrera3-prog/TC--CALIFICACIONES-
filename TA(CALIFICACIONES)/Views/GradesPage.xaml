<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TA_CALIFICACIONES_.Views.GradesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#E9E9E9">

    <Grid RowDefinitions="Auto,*" RowSpacing="0">
        <Grid Grid.Row="0"
              BackgroundColor="#1B1F24"
              HeightRequest="72"
              Padding="18,0"
              ColumnDefinitions="*,Auto">
            <Label Grid.Column="0"
                   Text="Calificaciones"
                   FontSize="32"
                   FontAttributes="Bold"
                   TextColor="#A36BEF"
                   VerticalOptions="Center" />

            <Border Grid.Column="1"
                    WidthRequest="32"
                    HeightRequest="32"
                    StrokeThickness="0"
                    BackgroundColor="#2F343A"
                    StrokeShape="RoundRectangle 8"
                    VerticalOptions="Center">
                <Label Text="☰"
                       FontSize="18"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="1" Padding="0,16,0,24">
            <VerticalStackLayout Spacing="18" Padding="0,0,0,8">
                <Border BackgroundColor="#D9EAF2"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18"
                        Margin="14,0"
                        Padding="18,16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalOptions="Center">
                        <Border WidthRequest="52"
                                HeightRequest="52"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 26"
                                BackgroundColor="#F7B6C5"
                                VerticalOptions="Center">
                            <Label Text="◎"
                                   FontSize="26"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="#0B5C8B" />
                        </Border>

                        <Label Grid.Column="1"
                               x:Name="WelcomeLabel"
                               Text="Bienvenido, Carlos"
                               FontSize="34"
                               FontAttributes="Bold"
                               TextColor="#1C78B9"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <VerticalStackLayout Margin="14,0" Spacing="14">
                    <Label Text="Nombre del estudiante"
                           FontSize="20"
                           TextColor="#0F2338"
                           FontAttributes="Bold" />

                    <Border BackgroundColor="#DDEFF7"
                            Padding="16,8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12">
                        <Picker x:Name="StudentPicker"
                                Title="Seleccione estudiante"
                                TitleColor="#516577"
                                TextColor="#0F2338"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnStudentSelectionChanged" />
                    </Border>

                    <Label Text="Fecha"
                           FontSize="20"
                           TextColor="#0F2338"
                           FontAttributes="Bold" />

                    <Border BackgroundColor="#0C0C0C"
                            Padding="14,8"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16">
                        <DatePicker x:Name="FechaPicker"
                                    TextColor="White"
                                    BackgroundColor="Transparent" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="Nota Seguimiento 1"
                                   FontSize="18"
                                   TextColor="#0F2338"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="#CFCFCF"
                                    Padding="12,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Entry x:Name="Seguimiento1Entry"
                                       Placeholder="6"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F2338"
                                       PlaceholderColor="#5A5A5A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Examen 1"
                                   FontSize="18"
                                   TextColor="#0F2338"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="#CFCFCF"
                                    Padding="12,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Entry x:Name="Examen1Entry"
                                       Placeholder="6"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F2338"
                                       PlaceholderColor="#5A5A5A" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                        <VerticalStackLayout Grid.Column="0" Spacing="8">
                            <Label Text="Nota Seguimiento 2"
                                   FontSize="18"
                                   TextColor="#0F2338"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="#CFCFCF"
                                    Padding="12,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Entry x:Name="Seguimiento2Entry"
                                       Placeholder="6"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F2338"
                                       PlaceholderColor="#5A5A5A" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="8">
                            <Label Text="Examen 2"
                                   FontSize="18"
                                   TextColor="#0F2338"
                                   FontAttributes="Bold" />
                            <Border BackgroundColor="#CFCFCF"
                                    Padding="12,10"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10">
                                <Entry x:Name="Examen2Entry"
                                       Placeholder="6"
                                       Keyboard="Numeric"
                                       BackgroundColor="Transparent"
                                       TextColor="#0F2338"
                                       PlaceholderColor="#5A5A5A" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Button x:Name="CalculateButton"
                            Text="Calcular nota"
                            BackgroundColor="#0C79E4"
                            TextColor="White"
                            FontSize="20"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            CornerRadius="14"
                            Margin="0,4,0,0"
                            Clicked="OnCalculateClicked" />
                </VerticalStackLayout>

                <Label x:Name="ResultLabel"
                       Text="Estado: Complementario 😐 | Nota final: 6,00"
                       FontSize="18"
                       TextColor="#0F2338"
                       Margin="18,0,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
